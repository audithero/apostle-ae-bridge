{
  "comment": "Model wiring for the brief compiler (scripts/compile-brief.cjs). Swap models and prompt versions here, never in code.",
  "provider": "claude-cli",
  "model": "claude-opus-5-5",
  "effort": {
    "treatment": "high",
    "spec": "high",
    "instructional": "high"
  },
  "timeoutSec": {
    "treatment": 900,
    "spec": 1200,
    "instructional": 1800
  },
  "retries": 2,
  "prompts": {
    "treatment": "treatment.v1.md",
    "spec": "spec.v1.md",
    "instructional": "instructional.v1.md",
    "instructionalExample": "examples/instructional-demo.json"
  },
  "defaults": {
    "wpm": 150,
    "stage": "gallery",
    "easeProfile": "curvaceous",
    "tail": 2.5
  }
}
